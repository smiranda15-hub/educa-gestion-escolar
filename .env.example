# Generate a unique secret before first setup, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EDUCA_SETUP_KEY=replace-with-a-long-random-secret
# Optional, comma-separated browser origins allowed for state-changing API requests.
# EDUCA_ALLOWED_ORIGINS=https://educa.example.edu

# Push móvil Android: guarda el JSON de la cuenta de servicio de Firebase solo en el backend/Railway.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Optional: database file location. Defaults to ./data/educa.sqlite
# EDUCA_DB_PATH=./data/educa.sqlite
# API_PORT=3001
