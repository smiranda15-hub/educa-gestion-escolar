# Generate a unique secret before first setup, e.g. node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
EDUCA_SETUP_KEY=replace-with-a-long-random-secret
# Optional, comma-separated browser origins allowed for state-changing API requests.
# EDUCA_ALLOWED_ORIGINS=https://educa.example.edu

# Salida de correo SMTP. Configura estos valores en el servicio EDUCA (no en PostgreSQL).
# Usa la contraseña de aplicación SMTP del proveedor, no la compartas ni la subas a Git.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=notificaciones@example.com
# SMTP_PASS=replace-with-mailbox-app-password
# SMTP_FROM=EDUCA <notificaciones@example.com>
# SMTP_REPLY_TO=soporte@example.com
# EDUCA_PUBLIC_URL=https://educagestionescolar.study

# Push móvil Android: guarda el JSON de la cuenta de servicio de Firebase solo en el backend/Railway.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Identidad verificable del proveedor para la política pública /privacidad. Completa solo con datos legales confirmados.
# EDUCA_PROVIDER_NAME=
# EDUCA_PROVIDER_NIT=
# EDUCA_PROVIDER_ADDRESS=
# EDUCA_PRIVACY_EMAIL=
# EDUCA_PRIVACY_PHONE=
# Optional: database file location. Defaults to ./data/educa.sqlite
# EDUCA_DB_PATH=./data/educa.sqlite
# API_PORT=3001
