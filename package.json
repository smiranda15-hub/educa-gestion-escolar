{
  "name": "educa-gestion-escolar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "desktop:dev": "electron .",
    "desktop:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "@vitejs/plugin-react": "latest",
    "bootstrap": "^5.3.8",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "co.educa.gestionescolar.desktop",
    "productName": "EDUCA Gestión Escolar",
    "directories": {
      "output": "artifacts/windows"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EDUCA Gestión Escolar"
    }
  },
  "allowScripts": {
    "electron@39.8.10": true,
    "electron-winstaller@5.4.0": true
  }
}
